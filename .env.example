# Ambil dari Supabase project kamu: Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxx

# Service role key JANGAN pernah dipakai di frontend, ini cuma dipakai di server (API routes)
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxx

# Password untuk masuk ke halaman admin dalam format bcrypt hash.
# Generate hash setelah npm install:
#   node -e "require('bcryptjs').hash('passwordkamu', 12).then(console.log)"
ADMIN_PASSWORD=\$2b\$12\$ganti_dengan_hash_bcrypt

# Opsional: secret untuk menandatangani cookie session admin.
# Jika kosong, ADMIN_PASSWORD dipakai sebagai fallback.
SESSION_SECRET=
