# Ambil dari Supabase project kamu: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxx

# Service role key JANGAN pernah dipakai di frontend, ini cuma dipakai di server (API routes)
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxx

# Password untuk masuk ke halaman admin (ganti dengan password kuat)
ADMIN_PASSWORD=gantidenganpasswordkuat123
