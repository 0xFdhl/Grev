# Ambil dari Supabase project kamu: Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxx

# Service role key JANGAN pernah dipakai di frontend, ini cuma dipakai di server (API routes)
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxx

# Password untuk masuk ke halaman admin dalam format bcrypt hash.
# Generate hash setelah npm install:
#   node -e "require('bcryptjs').hash('passwordkamu', 12).then(console.log)"
ADMIN_PASSWORD=\$2b\$12\$ganti_dengan_hash_bcrypt

# Opsional: secret untuk menandatangani cookie session admin.
# Jika kosong, ADMIN_PASSWORD dipakai sebagai fallback.
SESSION_SECRET=

# Google Maps Demo Key (khusus testing/prototyping, bukan production).
# Dapatkan di https://developers.google.com/maps/demo-key -> "Get a Demo Key" (gratis, tanpa kartu kredit).
# Ada limit harian; kalau traffic besar nanti, upgrade ke API key berbayar dengan billing account.
NEXT_PUBLIC_GOOGLE_MAPS_DEMO_KEY=isi_dengan_demo_key_dari_developers.google.com/maps/demo-key

# Opsional: rate limit yang konsisten di produksi (serverless/Vercel).
# Daftar gratis di https://upstash.com (login GitHub/Google) -> Create database
# -> copy "REST URL" dan "Write/Read Token" ke sini.
# Jika kosong, app pakai fallback in-memory (cukup untuk dev lokal,
# tapi tidak efektif di serverless multi-instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Batas scan per IP per menit. Default 1200 untuk jaringan Wi-Fi bersama.
# Batas login tetap terpisah: 5 percobaan / 15 menit.
REDIRECT_RATE_LIMIT_PER_MINUTE=1200

# Origin HTTPS untuk QR/NFC baru (tanpa path). Kosong = https://bebetterdevelo.my.id.
# NEXT_PUBLIC_ dibaca saat build: rebuild/deploy setelah mengubahnya.
NEXT_PUBLIC_SITE_URL=https://bebetterdevelo.my.id
